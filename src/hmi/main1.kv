#:import MapView kivy_garden.mapview.MapView

<Button>
    font_size: 12
    size_hint: (0.2, 0.1)

<MapViewExample>:
    MapView:
        id: map
        lat: 54.7843
        lon: 9.43961
        zoom: 16

    TextInput:
        id: here_input
        text: "Enter starting location"
        multiline: False
        size_hint: (.5, .1)
        pos_hint: {"x":0, "top":.2}
    
    Button:
        text: "Submit here"
        size_hint: (.5, .1)
        pos_hint: {"x":0, "top":.1}
        on_release: root.find_here()

    TextInput:
        id: goto_input
        text: "Enter end location"
        multiline: False
        size_hint: (.5, .1)
        pos_hint: {"x":0.5, "top":.2}

    Button:
        text: "Submit goto"
        size_hint: (.5, .1)
        pos_hint: {"x":0.5, "top":.1}
        on_release: root.find_goto()

    Button:
        text: "Remove here"
        pos_hint: {"x":0, "top":1}
        on_release: root.remove_here()

    Button:
        text: "Remove goto"
        pos_hint: {"x":0.8, "top":1}
        on_release: root.remove_goto()