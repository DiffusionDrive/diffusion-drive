#:import MapView kivy_garden.mapview.MapView
#:import Factory kivy.factory.Factory

<MyPopup@Popup>
    auto_dismiss: False
    size_hint: 0.8, 0.8
    pos_hint: {"x":0.2, "top":0.9}

    title: "This is a popup box"
    
    BoxLayout:
        orientation: "vertical"
        size: root.width, root.height

        Label:
            text: "Where to go?"
            font_size: 24
        
        TextInput:
            id: goto_input
            multiline: False
            size_hint: (1, .2)
        
        Button:
            text: "Submit goto"
            font_size: 24
            on_release: root.find_goto()

        Button:
            text: "Close Me!"
            font_size: 24
            on_release: root.dismiss()

<Button>
    font_size: 12
    size_hint: (0.2, 0.2)

<MapViewExample>:
    MapView:
        id: map
        lat: 54.7843
        lon: 9.43961
        zoom: 16

    TextInput:
        id: here_input
        text: "Enter starting location"
        multiline: False
        size_hint: (.5, .1)
        pos_hint: {"x":0, "top":.2}
    
    Button:
        text: "Submit here"
        size_hint: (.5, .1)
        pos_hint: {"x":0, "top":.1}
        on_release: root.find_here()

    TextInput:
        id: goto_input
        text: "Enter end location"
        multiline: False
        size_hint: (.5, .1)
        pos_hint: {"x":0.5, "top":.2}

    Button:
        text: "Submit goto"
        size_hint: (.5, .1)
        pos_hint: {"x":0.5, "top":.1}
        on_release: root.find_goto()

    Button:
        text: "Return Home"
        pos_hint: {"x":0, "top":1}
        on_release: root.return_home()

    Button:
        text: "Popup"
        pos_hint: {"x":0.8, "top":1}
        on_release: Factory.MyPopup().open()