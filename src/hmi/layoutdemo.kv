ScreenManagement:
    MainScreen:
    Screen1:
    Screen2:
    Screen3:
	
<MainScreen>:
    name: 'main'

    Button:
        on_release: app.root.current = 'goto'
        text: 'Another Screen'
        font_size: 50
            
<Screen1>:
    name: 'goto'

    Button:
        on_release: app.root.current = 'from'
        text: 'goto'
        font_size: 50

<Screen2>:
    name: 'from'

    Button:
        on_release: app.root.current = 'main_mark'
        text: 'from'
        font_size: 50

<Screen3>:
    name: 'main_mark'

    Button:
        on_release: app.root.current = 'goto'
        text: 'main_mark'
        font_size: 50