ScreenManagement:
    MainScreen:
    Screen1:
    Screen2:
    Screen3:

<Button>
    font_size: 24
    size_hint: (0.3, 0.3)

<MainScreen>:

    FloatLayout:
        name: 'map'
        size: root.width, root.height

        MapView:
            lat: 52.52
            lon: 13.405
            zoom: 16

        Button:
            text: "Top Left"
            pos_hint: {"x":0, "top":1}

        Button:
            text: "Top Right"
            pos_hint: {"x":.7, "top":1}
            on_release: app.root.current = 'goto'
            
<Screen1>:
    name: 'goto'
    size: root.width, root.height

    Button:
        text: 'goto'
        on_release: app.root.current = 'from'

<Screen2>:
    name: 'from'
    size: root.width, root.height

    Button:
        text: 'from'
        on_release: app.root.current = 'map_mark'

<Screen3>:
    name: 'map_mark'
    MapView:
        lat: 52.52
        lon: 13.405
        zoom: 16

        MapMarkerPopup:
            lat: 52.52
            lon: 13.403

            popup_size:dp(230),dp(130)
    
        MapMarkerPopup:
            lat: 52.52
            lon: 13.406

            popup_size:dp(230),dp(130)
    
