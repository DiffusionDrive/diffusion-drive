ScreenManagement:
    MainScreen:
    Screen1:
    Screen2:
    Screen3:
	
<MainScreen>:
    name: 'map'

    Button:
        on_release: app.root.current = 'goto'
        text: 'Another Screen'
        font_size: 50
            
<Screen1>:
    name: 'goto'

    Button:
        on_release: app.root.current = 'from'
        text: 'goto'
        font_size: 50

<Screen2>:
    name: 'from'

    Button:
        on_release: app.root.current = 'map_mark'
        text: 'from'
        font_size: 50

<Screen3>:
    name: 'map_mark'
    MapView:
        lat: 52.52
        lon: 13.405
        zoom: 16

        MapMarkerPopup:
            lat: 52.52
            lon: 13.403

            popup_size:dp(230),dp(130)
    
        MapMarkerPopup:
            lat: 52.52
            lon: 13.406

            popup_size:dp(230),dp(130)
    
