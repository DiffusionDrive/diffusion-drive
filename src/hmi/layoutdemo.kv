ScreenManagement:
    MainScreen:
    Screen1:
    Screen2:
    Screen3:

<Button>
    font_size: 16
    size_hint: (0.2, 0.2)

<MainScreen>:

    FloatLayout:
        name: 'map'
        size: root.width, root.height

        MapView:
            lat: 52.52
            lon: 13.405
            zoom: 16

        Button:
            text: "Top Left"
            pos_hint: {"x":0, "top":1}

        Button:
            text: "Top Right"
            pos_hint: {"x":.8, "top":1}
            on_release: app.root.current = 'goto'
            
<Screen1>:
    name: 'goto'
    size: root.width, root.height

    Label:
        id: goto_label
        text: "Where to go?"
        color: "black"
        font_size: 32

    TextInput:
        id: goto_input
        multiline: False
        size_hint: (1, .2)

    Button:
        text: 'Submit'
        pos_hint: {"x":.8, "top":0.8}
        on_press: root.press()
        on_release: app.root.current = 'from'

<Screen2>:
    name: 'from'
    size: root.width, root.height

    Label:
        id: from_label
        text: "Where are you?"
        color: "black"
        font_size: 32

    TextInput:
        id: from_input
        multiline: False
        size_hint: (1, .2)

    Button:
        text: 'Submit'
        pos_hint: {"x":.8, "top":0.8}
        on_press: root.press()
        on_release: app.root.current = 'map_mark'

<Screen3>:
    name: 'map_mark'
    MapView:
        lat: 52.52
        lon: 13.405
        zoom: 16

        MapMarkerPopup:
            lat: 52.5195
            lon: 13.403

            popup_size:dp(230),dp(130)
    
        MapMarkerPopup:
            source: "location.png"
            lat: 52.522
            lon: 13.406

            popup_size:dp(230),dp(130)
    
    Button:
        text: "Top Right"
        pos_hint: {"x":.8, "top":1}
        on_release: app.root.current = 'goto'