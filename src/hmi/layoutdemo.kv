ScreenManagement:
    MainScreen:
    Screen1:
    Screen2:
    Screen3:
    Screen4:
    Screen5:

<Button>
    font_size: 16
    size_hint: (0.2, 0.2)

<MainScreen>:
    name: 'map'
    FloatLayout:
        size: root.width, root.height

        MapView:
            lat: 54.7843
            lon: 9.43961
            zoom: 16

        Button:
            text: "Top Left"
            pos_hint: {"x":0, "top":1}

        Button:
            text: "Top Right"
            pos_hint: {"x":.8, "top":1}
            on_press: app.root.current = 'goto'
            
<Screen1>:
    name: 'goto'
    size: root.width, root.height

    Label:
        id: goto_label
        text: "Where to go?"
        color: "black"
        font_size: 32

    TextInput:
        id: goto_input
        multiline: False
        size_hint: (1, .2)

    Button:
        text: 'Submit'
        pos_hint: {"x":.8, "top":0.8}
        on_press: root.press()
        on_press: app.root.current = 'from'

<Screen2>:
    name: 'from'
    size: root.width, root.height

    Label:
        id: from_label
        text: "Where are you?"
        color: "black"
        font_size: 32

    TextInput:
        id: from_input
        multiline: False
        size_hint: (1, .2)

    Button:
        text: 'Submit'
        pos_hint: {"x":.8, "top":0.8}
        on_press: root.press()
        on_press: app.root.current = 'mark'

<Screen3>:
    name: 'mark'
    MapView:
        id: map_mark
        lat: 54.7843
        lon: 9.43961
        zoom: 16

    Button:
        text: "Start Travel"
        pos_hint: {"x":.8, "top":.8}
        on_press: app.root.current = 'moving'

    Button:
        text: "Show Marks"
        pos_hint: {"x":.8, "top":.3}


<Screen4>:
    name: 'moving'
    MapView:
        lat: 54.7843
        lon: 9.43961
        zoom: 16

        MapMarkerPopup:
            lat: 54.783
            lon: 9.439

            popup_size:dp(230),dp(130)
    
        MapMarkerPopup:
            source: "goto.png"
            lat: 54.785
            lon: 9.4397

            popup_size:dp(230),dp(130)

    ProgressBar:
        id: my_progress_bar
        min: 0
        max: 1
        pos_hint: {'x':.1}
        size_hint_x: .8

    Button:
        text: "Moving"
        on_press: root.start_timer()

    Button:
        text: "End Travel"
        pos_hint: {"x":.8, "top":.8}
        on_press: app.root.current = 'reached'

<Screen5>:
    name: 'reached'
    MapView:
        lat: 54.7843
        lon: 9.43961
        zoom: 16
    
        MapMarkerPopup:
            source: "reached.png"
            lat: 54.785
            lon: 9.4397

            popup_size:dp(230),dp(130)
    
    Button:
        text: "Home Page"
        pos_hint: {"x":.8, "top":1}
        on_press: app.root.current = 'map'